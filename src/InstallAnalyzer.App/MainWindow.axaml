<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InstallAnalyzer.App.ViewModels"
        x:Class="InstallAnalyzer.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Install Analyzer"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F4">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18,14,18,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="Install Analyzer" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="Silent install and uninstall commands." Foreground="#78716C" FontSize="12"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="add" Content="Add installer" Command="{Binding BrowseCommand}" VerticalAlignment="Center"/>
      </Grid>

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Files}" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FileItem">
            <Button Classes="chip" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" Margin="0,0,6,4">
              <TextBlock Text="{Binding Name}"/>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel Grid.Row="2" Margin="0,14,0,0">
        <Border IsVisible="{Binding ShowEmpty}" BorderBrush="#D6D3D1" BorderThickness="1.5" CornerRadius="14" Background="#FFFFFF"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="Drop an installer" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="MSI, EXE, MSIX, or MSP. Nothing is installed. You get a command to copy."
                       Foreground="#78716C" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </Border>

        <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Selected.ProductLine}" FontSize="18" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Selected.Publisher}" Foreground="#78716C" FontSize="12"/>
                  <TextBlock Text="{Binding Selected.Name}" Foreground="#78716C" FontSize="12"/>
                  <TextBlock Text="{Binding Selected.SizeText}" Foreground="#78716C" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Selected.FamilyText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Selected.ConfidenceText}" Foreground="#78716C" FontSize="12" VerticalAlignment="Center"/>
                  <Button Classes="quiet" Content="Query help" Command="{Binding AskHelpCommand}" IsVisible="{Binding Selected.CanQueryHelp}" Padding="8,3"/>
                </StackPanel>
                <TextBlock Text="{Binding Selected.Evidence}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="420"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Selected.HelpOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="#44403C" TextWrapping="Wrap"
                       IsVisible="{Binding Selected.HasHelpOutput}"/>
            <TextBlock Text="{Binding Selected.HelpMessage}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding Selected.HasHelpMessage}"/>

            <Border Background="#1C1917" CornerRadius="8" Padding="10,6" IsVisible="{Binding Selected.HasInstall}">
              <Grid ColumnDefinitions="78,*,Auto">
                <TextBlock Text="INSTALL" Foreground="#99F6E4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Selected.InstallText}" FontFamily="Cascadia Code, Consolas, monospace" Foreground="#FAFAF9" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Classes="ghost" Content="Copy" Command="{Binding CopyInstallCommand}"/>
                  <Button Classes="ghost" Content="Copy with log" Command="{Binding CopyInstallLogCommand}" IsVisible="{Binding Selected.HasInstallLog}"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Selected.InstallNote}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Selected.HasInstall}"/>

            <Border Background="#1C1917" CornerRadius="8" Padding="10,6" IsVisible="{Binding Selected.HasUninstall}">
              <Grid ColumnDefinitions="78,*,Auto">
                <TextBlock Text="UNINSTALL" Foreground="#99F6E4" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Selected.UninstallText}" FontFamily="Cascadia Code, Consolas, monospace" Foreground="#FAFAF9" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                  <Button Classes="ghost" Content="Copy" Command="{Binding CopyUninstallCommand}"/>
                  <Button Classes="ghost" Content="Copy with log" Command="{Binding CopyUninstallLogCommand}" IsVisible="{Binding Selected.HasUninstallLog}"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Selected.UninstallNote}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Selected.HasUninstall}"/>

            <Border Background="#FFF7ED" CornerRadius="8" Padding="10,6" IsVisible="{Binding Selected.HasAdvisory}">
              <TextBlock Text="{Binding Selected.Advisory}" Foreground="#9A3412" FontSize="12" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Spacing="10">
              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="10" Padding="12,8"
                      IsVisible="{Binding Selected.HasSwitches}">
                <StackPanel Spacing="0">
                  <TextBlock Text="SWITCHES" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,6"/>
                  <Border BorderBrush="#E7E5E4" BorderThickness="0,0,0,1" Padding="0,0,0,4" Margin="0,0,0,2">
                    <Grid ColumnDefinitions="168,*,120">
                      <TextBlock Text="Switch" Foreground="#A8A29E" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="Description" Foreground="#A8A29E" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="2" Text="From" Foreground="#A8A29E" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Selected.Switches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SwitchRow">
                        <Grid ColumnDefinitions="168,*,120" Margin="0,3">
                          <TextBlock Text="{Binding Flag}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Meaning}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#78716C" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="10" Padding="12,8"
                      IsVisible="{Binding Selected.HasPayloads}">
                <StackPanel Spacing="4">
                  <TextBlock Text="EMBEDDED" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Selected.Payloads}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PayloadRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#78716C" FontSize="12"/>
                            <TextBlock Text="{Binding CommandText}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="#44403C" TextWrapping="Wrap"/>
                          </StackPanel>
                          <Button Grid.Column="1" Classes="quiet" Content="Open" Click="OpenPayloadClick" VerticalAlignment="Center" IsVisible="{Binding CanOpen}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Panel>

      <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#78716C" FontSize="12" Margin="0,8,0,0" IsVisible="{Binding !IsBusy}"/>
      <TextBlock Grid.Row="3" Text="{Binding BusyText}" Foreground="#0F766E" FontSize="12" Margin="0,8,0,0" IsVisible="{Binding IsBusy}"/>
    </Grid>

    <Border IsVisible="{Binding ShowHelpConfirm}" Background="#801C1917">
      <Border Background="#FFFFFF" CornerRadius="16" Padding="22" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Query help?" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#44403C"
                     Text="This tries each help switch inside a sandbox that cannot change Program Files, the user profile, or the network. The installer is stopped as soon as it opens. Nothing is installed."/>
          <TextBlock FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="#78716C" TextWrapping="Wrap"
                     Text="{Binding Selected.HelpArgument}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="quiet" Content="Cancel" Command="{Binding CancelHelpCommand}"/>
            <Button Classes="primary" Content="Run help query" Command="{Binding ConfirmHelpCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
