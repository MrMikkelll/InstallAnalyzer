<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:InstallAnalyzer.App.ViewModels"
        x:Class="InstallAnalyzer.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Install Analyzer"
        Width="1100"
        Height="760"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F4">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22,18,22,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Install Analyzer" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="Silent install and uninstall commands." Foreground="#78716C" FontSize="13"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="quiet" Content="Browse" Command="{Binding BrowseCommand}" VerticalAlignment="Center"/>
      </Grid>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0"
                    IsVisible="{Binding HasSelection}">
        <ItemsControl ItemsSource="{Binding Files}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FileItem">
              <Button Classes="chip" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                <TextBlock Text="{Binding Name}"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Panel Grid.Row="2" Margin="0,14,0,0">
        <Border IsVisible="{Binding ShowEmpty}" BorderBrush="#D6D3D1" BorderThickness="1.5" CornerRadius="14" Background="#FFFFFF"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
            <TextBlock Text="Drop an installer" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="MSI, EXE, MSIX, or MSP. Nothing is installed. You get a command to copy."
                       Foreground="#78716C" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
          </StackPanel>
        </Border>

        <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,*">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Selected.ProductLine}" FontSize="20" FontWeight="SemiBold"/>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Selected.Publisher}" Foreground="#78716C" FontSize="13"/>
                <TextBlock Text="{Binding Selected.Name}" Foreground="#78716C" FontSize="13"/>
                <TextBlock Text="{Binding Selected.SizeText}" Foreground="#78716C" FontSize="13"/>
              </StackPanel>
            </StackPanel>

            <Border Background="#1C1917" CornerRadius="12" Padding="14" IsVisible="{Binding Selected.HasInstall}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Text="INSTALL" Foreground="#99F6E4" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Grid.Column="1" Text="{Binding Selected.InstallConfidence}" Foreground="#A8A29E" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                </Grid>
                <TextBlock Text="{Binding Selected.InstallText}" FontFamily="Cascadia Code, Consolas, monospace" Foreground="#FAFAF9" FontSize="13" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="ghost" Content="Copy" Command="{Binding CopyInstallCommand}"/>
                  <Button Classes="ghost" Content="Copy with log" Command="{Binding CopyInstallLogCommand}" IsVisible="{Binding Selected.HasInstallLog}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Selected.InstallNote}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Selected.HasInstall}"/>

            <Border Background="#1C1917" CornerRadius="12" Padding="14" IsVisible="{Binding Selected.HasUninstall}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="UNINSTALL" Foreground="#99F6E4" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Grid.Column="1" Text="{Binding Selected.UninstallConfidence}" Foreground="#A8A29E" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="{Binding Selected.UninstallText}" FontFamily="Cascadia Code, Consolas, monospace" Foreground="#FAFAF9" FontSize="13" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="ghost" Content="Copy" Command="{Binding CopyUninstallCommand}"/>
                  <Button Classes="ghost" Content="Copy with log" Command="{Binding CopyUninstallLogCommand}" IsVisible="{Binding Selected.HasUninstallLog}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding Selected.UninstallNote}" Foreground="#78716C" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Selected.HasUninstall}"/>

            <Border Background="#FFF7ED" CornerRadius="12" Padding="12,10" IsVisible="{Binding Selected.HasAdvisory}">
              <TextBlock Text="{Binding Selected.Advisory}" Foreground="#9A3412" FontSize="13" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="12">
              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <StackPanel Spacing="6">
                  <TextBlock Text="DETECTION" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Background="#F0FDFA" CornerRadius="999" Padding="8,3">
                      <TextBlock Text="{Binding Selected.FamilyText}" Foreground="#115E59" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding Selected.ConfidenceText}" Foreground="#78716C" FontSize="13" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Selected.Evidence}" Foreground="#78716C" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="14" Padding="14,12"
                      IsVisible="{Binding Selected.HasSwitches}">
                <StackPanel Spacing="4">
                  <TextBlock Text="SWITCHES" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Selected.Switches}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SwitchRow">
                        <Grid ColumnDefinitions="190,*,120" Margin="0,6">
                          <TextBlock Text="{Binding Flag}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="1" Text="{Binding Meaning}" FontSize="13" TextWrapping="Wrap"/>
                          <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#78716C" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="14" Padding="14,12"
                      IsVisible="{Binding Selected.HasPayloads}">
                <StackPanel Spacing="4">
                  <TextBlock Text="EMBEDDED" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding Selected.Payloads}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PayloadRow">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#78716C" FontSize="12"/>
                            <TextBlock Text="{Binding CommandText}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="#44403C" TextWrapping="Wrap"/>
                          </StackPanel>
                          <Button Grid.Column="1" Classes="quiet" Content="Open" Click="OpenPayloadClick" VerticalAlignment="Center" IsVisible="{Binding CanOpen}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Background="#FFFFFF" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="14" Padding="14,12">
                <StackPanel Spacing="8">
                  <TextBlock Text="HELP" Foreground="#78716C" FontSize="11" FontWeight="Bold" LetterSpacing="1"/>
                  <TextBlock Text="{Binding Selected.HelpOutput}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" TextWrapping="Wrap"
                             IsVisible="{Binding Selected.HasHelpOutput}"/>
                  <TextBlock Text="{Binding Selected.HelpMessage}" Foreground="#78716C" FontSize="13" TextWrapping="Wrap"
                             IsVisible="{Binding Selected.HasHelpMessage}"/>
                  <Button Classes="quiet" Content="Query help" Command="{Binding AskHelpCommand}" IsVisible="{Binding Selected.CanQueryHelp}" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Panel>

      <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#78716C" FontSize="12" Margin="0,8,0,0" IsVisible="{Binding !IsBusy}"/>
      <TextBlock Grid.Row="3" Text="{Binding BusyText}" Foreground="#0F766E" FontSize="12" Margin="0,8,0,0" IsVisible="{Binding IsBusy}"/>
    </Grid>

    <Border IsVisible="{Binding ShowHelpConfirm}" Background="#801C1917">
      <Border Background="#FFFFFF" CornerRadius="16" Padding="22" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="Query help?" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#44403C"
                     Text="This starts the installer with a help switch, waits about 12 seconds, then stops it. A few installers ignore the help switch and begin installing. Run this only on a file you trust, preferably in a VM."/>
          <TextBlock FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Foreground="#78716C"
                     Text="{Binding Selected.HelpArgument}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="quiet" Content="Cancel" Command="{Binding CancelHelpCommand}"/>
            <Button Classes="primary" Content="Run help query" Command="{Binding ConfirmHelpCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
